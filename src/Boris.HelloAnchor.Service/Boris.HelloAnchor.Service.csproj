<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!--
    LocalSystem Windows service (SPEC §6). Tracks interactive sessions and launches one elevated
    agent into each, supervising them inside a kill-on-close Job Object.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Boris.HelloAnchor.Service</RootNamespace>
    <AssemblyName>Boris.HelloAnchor.Service</AssemblyName>
    <!-- CsWin32 generates pointer-based signatures. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Publish settings used by build.ps1 (SPEC §8.1): self-contained, not single-file, not trimmed. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The Worker SDK adds a user-secrets ID by default; it is not wanted for a LocalSystem service. -->
    <UserSecretsId></UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boris.HelloAnchor.Core\Boris.HelloAnchor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
    <AdditionalFiles Include="NativeMethods.json" />
  </ItemGroup>
</Project>
