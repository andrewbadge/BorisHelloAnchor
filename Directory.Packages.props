<Project>
  <!--
    Central Package Management (SPEC §3). Every NuGet version lives here so the Service and Agent,
    which are published into the same folder, can never ship different versions of a shared DLL.
    Versions were checked against nuget.org when added; re-check before bumping.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated Win32 P/Invoke (build-time only; not redistributed). -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />

    <!-- Hosting and logging. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.12" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!--
      Installer (build-time only). WiX v5 is used deliberately: v6+ adds the Open Source Maintenance Fee EULA.
      Keep this in step with the WixToolset.Sdk version in the .wixproj Sdk attribute.
    -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="5.0.2" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
